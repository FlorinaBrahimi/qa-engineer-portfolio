        "-p",
        "no:cacheprovider"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.vscode/local.env",
      "justMyCode": true,
      "presentation": {
        "group": "1 Local tests",
        "order": 2
      }
    },
    {
