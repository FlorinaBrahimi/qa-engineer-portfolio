{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tests: all (local)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-ra",
        "--html",
        "reports/all.html",
        "--self-contained-html",
        "-p",
        "no:cacheprovider"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.vscode/local.env",
      "justMyCode": true,
      "presentation": {
        "group": "1 Local tests",
        "order": 1
      }
    },
    {
      "name": "Tests: smoke",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-m",
