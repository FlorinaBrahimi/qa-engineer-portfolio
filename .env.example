# Copy to .env and fill in what you have. Everything is optional; see docs/09_accounts_and_setup.md

# App / tests
SUBMISSION_API_KEY=qa-demo-key
# BASE_URL=http://localhost:5001          # set to run tests against a deployed instance

# AI-assisted test generation (ai_testing/generate_tests.py)
# ANTHROPIC_API_KEY=

# AWS, only for live S3 / Lambda / CloudWatch (tests use moto without these)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-2

# Real-device mobile runs (tests/mobile)
# APPIUM_SERVER_URL=
# APPIUM_DEVICE=iPhone 15

# --- Jira: for `make jira`, which logs the defects in docs/04_defect_management.md ---
# Site address, e.g. https://yourname.atlassian.net
JIRA_BASE_URL=
# The email you sign in to Atlassian with
JIRA_EMAIL=
# API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# The short project key shown before issue numbers, e.g. QA
JIRA_PROJECT_KEY=
